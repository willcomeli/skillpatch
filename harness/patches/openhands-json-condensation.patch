+def test_json_callback_serializes_condensation_event_sets():
+    """Guards the set serialization crash in CLI commit 0403f1a79a9f."""
+    from openhands.sdk.event.condenser import Condensation
+
+    event = Condensation(
+        forgotten_event_ids={"event-one", "event-two"},
+        summary="Conversation summary",
+        summary_offset=0,
+        llm_response_id="test-response",
+    )
+    with patch("builtins.print") as mock_print:
+        json_callback(event)
+    payload = json.loads(mock_print.call_args.args[0])
+    assert payload["kind"] == "Condensation"
+    assert set(payload["forgotten_event_ids"]) == {"event-one", "event-two"}
+    assert payload["summary"] == "Conversation summary"
