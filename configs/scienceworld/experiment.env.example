# Copy to .env.scienceworld at the repository root; fill URLs and keys.
# Model IDs are editable if your gateway uses different names.
EXECUTION_MODEL=deepseek-flash
EXECUTION_BASE_URL=
EXECUTION_API_KEY=
METHOD_MODEL=gpt-6.1-sol
METHOD_BASE_URL=
METHOD_API_KEY=

# Confirmed: EviSkill code default (empty), rather than SkillNet's easy mode.
SCIENCEWORLD_SIMPLIFICATION=

# Independent task processes; 1 keeps serial execution. Set explicitly for a new run.
# Execution covers SkillOpt train/validation/test and the final SkillPatch test.
SCIENCEWORLD_EXECUTION_WORKERS=1
# Each worker collects a training trajectory, then diagnoses/generates its patches.
SCIENCEWORLD_SKILLPATCH_WORKERS=1
# Infrastructure task retries after the first attempt; unlimited keeps retrying.
SCIENCEWORLD_TASK_MAX_RETRIES=5
# Retry the SAME model request in the live environment; unlimited preserves task progress during outages.
SCIENCEWORLD_REQUEST_MAX_RETRIES=0

# SkillPatch diagnosis and generation use Codex with the method model above.
# METHOD_BASE_URL must support Responses (SkillOpt also uses Chat Completions).
SKILLPATCH_HARNESS=codex
# Optional override; otherwise use the local compiled harness or codex on PATH.
# SKILLPATCH_AGENT_COMMAND=/absolute/path/to/codex

# Defaults point to the ScienceWorld already downloaded beside this repo.
# SCIENCEWORLD_PATH=/absolute/path/to/ScienceWorld
# SCIENCEWORLD_JAR_PATH=/absolute/path/to/ScienceWorld/scienceworld/scienceworld.jar
# Optional private Java runtime; its bin directory is added only for this experiment.
# JAVA_HOME=/absolute/path/to/jre/Contents/Home
