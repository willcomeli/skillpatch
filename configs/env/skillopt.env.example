# skillopt: SkillOpt training and optimization
# Fill in the key, then manually copy this entire file into the project-root .env.
# Run commands with --env-file .env; non-empty process variables take precedence.
# Model name and experiment parameters are configured in TOML/YAML/CLI, not here.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.ciyuan.fast

# Shared optimizer for all three methods: gpt-5.5.
# GPT_BASE_URL must include the API root, for example the provider's /v1 path.
GPT_API_KEY=
GPT_BASE_URL=
